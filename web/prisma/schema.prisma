generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  clerkUserId  String        @unique
  email        String        @unique
  name         String?
  imageUrl     String?
  transactions Transaction[]
  accounts     Account[]
  budgetGroups BudgetGroup[]
  budgetMembers BudgetMember[]  // ← add this line
  budgets      Budget[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0)
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id                String             @id @default(uuid())
  type              TransactionType
  amount            Decimal
  description       String?
  // No @default here — caller must supply the transaction date explicitly
  date              DateTime
  category          String
  receiptUrl        String?
  isRecurring       Boolean            @default(false)
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus  @default(COMPLETED)
  merchantName      String?
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([accountId])
  @@map("transactions")
}

// FIX 1: Removed @unique on userId so a user can have multiple category budgets.
// Added an optional `category` field so each budget can target a spending category.
// A @@unique([userId, category]) constraint prevents duplicate budgets for the
// same user + category pair. NULL category = the user's global/overall budget.
model Budget {
  id            String    @id @default(uuid())
  amount        Decimal
  // null = overall/global budget; a value = category-specific budget
  category      String?
  lastAlertSent DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // FIX 1 (cont.): Ensures one budget per (user, category) pair.
  // This replaces the old @unique on userId alone.
  @@unique([userId, category])
  @@index([userId])
  @@map("budgets")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model BudgetGroup {
  id        String   @id @default(cuid())
  userId    String
  // FIX 2: Removed hardcoded @default("My Group") — group name should be
  // supplied by the application layer, not defaulted at the DB level.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     BudgetMember[]
  expenses    BudgetExpense[]
  settlements BudgetSettlement[]
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_groups")
}

// FIX 3: Added optional `userId` so a BudgetMember can be linked to a real
// app User. This allows authentication checks, notifications, and balance
// visibility for registered users, while still supporting guest members
// (userId = null) for flexibility.
model BudgetMember {
  id      String  @id @default(cuid())
  name    String
  groupId String
  // null = guest/named-only member; set = linked to a real app User
  userId  String?

  group BudgetGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  expensesPaid    BudgetExpense[]    @relation("PaidBy")
  splits          BudgetSplit[]      @relation("MemberSplits")
  fromSettlements BudgetSettlement[] @relation("FromSettlements")
  toSettlements   BudgetSettlement[] @relation("ToSettlements")

  @@index([groupId])
  @@index([userId])
  @@map("budget_members")
}

// FIX 4: Renamed `paidBy` → `paidById` to make it clear this field holds
// a BudgetMember ID, not a name string. Also updated the relation field name.
model BudgetExpense {
  id        String   @id @default(cuid())
  desc      String
  amount    Float
  category  String
  // FIX 4: renamed from `paidBy` to `paidById` for clarity
  paidById  String
  groupId   String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        BudgetGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidByMember BudgetMember  @relation("PaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  splits       BudgetSplit[] @relation("ExpenseSplits")

  @@map("budget_expenses")
}

model BudgetSplit {
  id        String @id @default(cuid())
  memberId  String
  amount    Float
  expenseId String

  expense BudgetExpense @relation("ExpenseSplits", fields: [expenseId], references: [id], onDelete: Cascade)
  member  BudgetMember  @relation("MemberSplits", fields: [memberId], references: [id], onDelete: Cascade)

  // FIX 5: Added @@unique to prevent a member from having duplicate split
  // entries for the same expense, which would corrupt balance calculations.
  @@unique([expenseId, memberId])
  @@map("budget_splits")
}

model BudgetSettlement {
  id        String   @id @default(cuid())
  groupId   String
  fromId    String
  toId      String
  amount    Float
  settledAt DateTime @default(now())

  group BudgetGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  BudgetMember @relation("FromSettlements", fields: [fromId], references: [id], onDelete: Cascade)
  to    BudgetMember @relation("ToSettlements", fields: [toId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([fromId])
  @@index([toId])
  @@map("budget_settlements")
}
